"""
_common.py — shared setup for the DeepPBS conformational-augmentation figures.

Every figure script does `from _common import *`, which loads the two data
tables, derives the within-family delta table, and defines the colours,
labels, and helper functions the figures use.

DATA INPUTS (place alongside these scripts, or edit the paths below):
  perentry_condition.csv   seed-mean per-entry metrics (one row per tf/arm/dna/entry)
                           == artifact table4_perentry_condition.csv
  perseed_perentry.csv     per-seed x per-entry metrics (one row per tf/arm/dna/seed/entry)
                           == the perseed_perentry.csv checkpoint (family columns populated)

Both are produced by the extraction step documented in README.md; they are the
only external inputs — all figures derive from them.
"""
import warnings
import numpy as np
import pandas as pd
import scipy.stats as sps
import matplotlib as mpl
import matplotlib.pyplot as plt
from matplotlib.patches import Patch
from matplotlib.lines import Line2D
warnings.filterwarnings("ignore", category=mpl.MatplotlibDeprecationWarning)

# ---- data paths (edit if your files live elsewhere) ----
PERENTRY   = "perentry_condition.csv"   # seed-mean per entry        (table4)
PERSEED    = "perseed_perentry.csv"     # per-seed x per-entry        (checkpoint; family cols populated)
PERSEEDSUM = "perseed_summary.csv"      # per-seed benchmark-mean      (table2) — one row per tf/arm/dna/seed

# ---- load ----
pe = pd.read_csv(PERENTRY)              # cols: tf,arm,dna,entry,family,motif,tf_name,n_seeds,mean_*
_psx = pd.read_csv(PERSEED)             # cols: tf,arm,dna,seed,entry,family,...,m_*
pseed = pd.read_csv(PERSEEDSUM)         # cols: tf,arm,dna,seed,n_entries,mean_pearsonr,...,mean_mae
# labelled seeds only (s1-s5); drop the bare fold0 (seed 0) so figures match the
# delivered analysis, and flag same-family rows.
md = _psx[_psx.seed > 0].copy()
if "entry_key" not in md.columns:
    md["entry_key"] = md["entry"].astype(str) + ".npz"

# ---- pilot -> family / pdb ----
pilot_entryfam = {'ets1':'ETS','tbp':'TBP / β-saddle','egr1':'C2H2 zinc finger',
                  'engrailed':'Homeodomain','foxa':'Forkhead','lef1':'HMG-box',
                  'csl':'CSL/RBPJ','err':'Nuclear receptor (Zn)','nfat':'Rel/NF-κB (RHD)','runx':'Runt',
                  'hsf':'HSF','irf':'IRF'}
pilot_pdb = {'ets1':'1k79','tbp':'1tgh','egr1':'1aay','engrailed':'3hdd','foxa':'1vtn',
             'lef1':'2lef','csl':'3brg','err':'1lo1','nfat':'1a66','runx':'1hjc',
             'hsf':'5d5u','irf':'1if1'}
md["selffam"] = md.apply(lambda r: r.family == pilot_entryfam.get(r.tf), axis=1)

# ---- orderings ----
order  = ['ets1','tbp','egr1','engrailed','foxa','lef1','csl','err','nfat','runx','hsf','irf']  # all 12 pilots
order9 = ['ets1','tbp','egr1','engrailed','foxa','csl','err','nfat','runx','hsf','irf']  # within-family (lef1 excluded: no same-family entries)

# ---- within-family per-entry delta table (aug - base) used by fig6 ----
def _build_wq():
    rows=[]
    for tf in order:
        fam=pilot_entryfam[tf]
        for dna in ['frozen','relax']:
            b=pe[(pe.tf==tf)&(pe.arm=='baseline')&(pe.dna==dna)].set_index('entry')['mean_pearsonr']
            a=pe[(pe.tf==tf)&(pe.arm=='augmented')&(pe.dna==dna)].set_index('entry')['mean_pearsonr']
            common=b.index.intersection(a.index)
            if len(common)==0: continue
            famof=pe[(pe.tf==tf)&(pe.dna==dna)&(pe.arm=='baseline')].set_index('entry')['family']
            for e in common:
                rows.append(dict(tf=tf,dna=dna,entry=e,family=famof.get(e),
                                 augmented=a[e],baseline=b[e],dAug=a[e]-b[e],
                                 selffam=(famof.get(e)==fam)))
    return pd.DataFrame(rows)
wq = _build_wq()

# ---- colours (three lightness shades: all / other / same) ----
C_BASE='#9AA3AF'; C_FROZ='#3B7EA1'; C_RELAX='#E07B39'; C_BG='#C7CCD1'
GREY =['#D3D8DE','#9AA3AF','#5B6470']   # baseline
TEAL =['#AECCDD','#5D9BBE','#2C6280']   # augmented, frozen DNA
GREEN=['#BFE0B5','#74B96A','#2E7D32']   # augmented, relaxed DNA

# ---- labels ----
famlab={'ets1':'ETS','tbp':'TBP','egr1':'C2H2-ZF','engrailed':'Homeodomain','foxa':'Forkhead',
        'csl':'CSL/RBPJ','err':'Nuclear rec.','nfat':'Rel/NFAT','runx':'Runt',
        'hsf':'HSF','irf':'IRF','lef1':'HMG-box'}
ylab ={t:f"{t}  ·  {famlab.get(t, pilot_entryfam[t])}" for t in order}
lab2 ={'ets1':'ets1\nETS','tbp':'tbp\nTBP','egr1':'egr1\nC2H2-ZF','engrailed':'engrailed\nHomeodom.',
       'foxa':'foxa\nForkhead','csl':'csl\nCSL/RBPJ','err':'err\nNuc. rec.','nfat':'nfat\nRel/NFAT','runx':'runx\nRunt',
       'hsf':'hsf\nHSF','irf':'irf\nIRF','lef1':'lef1\nHMG-box'}
def ylab9(t): return f"{t} · {famlab[t]}"

# ---- six-group box geometry (fig7/fig8) ----
subsets=['all','other','same']
specs=[('baseline','all'),('baseline','other'),('baseline','same'),
       ('augmented','all'),('augmented','other'),('augmented','same')]
offs=[0.34,0.205,0.07,-0.07,-0.205,-0.34]; BW=0.115

# ---- helpers ----
def set_frame(ax, style="open"):
    show={"open":(False,False,True,True),"boxed":(True,True,True,True),"none":(False,False,False,False)}[style]
    for side,vis in zip(("top","right","bottom","left"),show):
        ax.spines[side].set_visible(vis)
        if vis: ax.spines[side].set_linewidth(0.6)
    ax.tick_params(direction="out", length=0 if style=="none" else 3, width=0.6)

def grp6(tf,dna,arm,subset,metric):
    s=pe[(pe.tf==tf)&(pe.arm==arm)&(pe.dna==dna)]; fam=pilot_entryfam[tf]
    if subset=='same':  s=s[s.family==fam]
    elif subset=='other': s=s[s.family!=fam]
    return s[metric].values

def grp(tf,dna,which,metric):
    arm='baseline' if which.startswith('base') else 'augmented'
    s=pe[(pe.tf==tf)&(pe.arm==arm)&(pe.dna==dna)]
    if which.endswith('same'): s=s[s.family==pilot_entryfam[tf]]
    return s[metric].values

def entry_delta(tf,dna,samefam):
    s=wq[(wq.tf==tf)&(wq.dna==dna)]
    s=s[s.selffam] if samefam else s[~s.selffam]
    return s.dAug.values

def hbox(ax, data, **kw):
    """Horizontal boxplot that works across matplotlib versions.
    mpl >= 3.9 uses orientation='horizontal'; older uses vert=False."""
    from packaging.version import parse as _v
    if _v(mpl.__version__) >= _v("3.9"):
        return ax.boxplot(data, orientation="horizontal", **kw)
    return ax.boxplot(data, vert=False, **kw)

def apply_figure_style():
    mpl.rcParams.update({"figure.dpi":110,"savefig.dpi":300,"font.size":9,
        "axes.titlesize":9,"axes.labelsize":9,"xtick.labelsize":8,"ytick.labelsize":8,
        "legend.fontsize":7.5,"pdf.fonttype":42,"ps.fonttype":42,"svg.fonttype":"none",
        "axes.grid":False,"figure.facecolor":"white","axes.facecolor":"white"})
