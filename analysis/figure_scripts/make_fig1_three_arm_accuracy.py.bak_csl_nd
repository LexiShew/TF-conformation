"""fig1_three_arm_accuracy — regenerates fig1_three_arm_accuracy.png
Run from this directory after placing perentry_condition.csv and perseed_perentry.csv here.
"""
from _common import *

apply_figure_style()

ps = pseed  # per-seed summary (tf,arm,dna,seed,mean_*)
arms = [('baseline', 'frozen', 'Baseline (no augmentation)', C_BASE),
        ('augmented', 'frozen', 'Augmented · frozen DNA', C_FROZ),
        ('augmented', 'relax', 'Augmented · relaxed DNA', C_RELAX)]


def seed_pts(tf, arm, dna):
    s = ps[(ps.tf == tf) & (ps.arm == arm) & (ps.dna == dna)]['mean_pearsonr'].values
    return s


def mean_ci(pts):
    pts = np.asarray(pts, float)
    if len(pts) == 0:
        return (np.nan, np.nan)
    m = pts.mean()
    if len(pts) < 2:
        return (m, 0)
    h = sps.t.ppf(0.975, len(pts) - 1) * pts.std(ddof=1) / np.sqrt(len(pts))
    return (m, h)


XL1 = (0.575, 0.665)
fig, ax = plt.subplots(figsize=(7.2, 5.2))
ys = np.arange(len(order))[::-1]
off = {0: +0.22, 1: 0.0, 2: -0.22}
for ai, (arm, dna, lab, col) in enumerate(arms):
    for yi, tf in zip(ys, order):
        m, h = mean_ci(seed_pts(tf, arm, dna))
        if np.isnan(m):
            continue
        lo_, hi_ = m - h, m + h
        y = yi + off[ai]
        cl_lo = max(lo_, XL1[0])
        cl_hi = min(hi_, XL1[1])
        ax.plot([cl_lo, cl_hi], [y, y], color=col, lw=1.6, zorder=3, solid_capstyle='butt')
        if lo_ >= XL1[0]:
            ax.plot([lo_, lo_], [y - 0.05, y + 0.05], color=col, lw=1.1, zorder=3)
        else:
            ax.annotate('', xy=(XL1[0], y), xytext=(XL1[0] + 0.004, y), arrowprops=dict(arrowstyle='-|>', color=col, lw=1.1))
        if hi_ <= XL1[1]:
            ax.plot([hi_, hi_], [y - 0.05, y + 0.05], color=col, lw=1.1, zorder=3)
        else:
            ax.annotate('', xy=(XL1[1], y), xytext=(XL1[1] - 0.004, y), arrowprops=dict(arrowstyle='-|>', color=col, lw=1.1))
        if XL1[0] <= m <= XL1[1]:
            ax.plot(m, y, 'o', color=col, ms=5, zorder=4, mec='white', mew=0.5)
ax.text(0.582, ys[order.index('csl')] - 0.22, 'n.d.', color=C_RELAX, fontsize=6, va='center', ha='left', style='italic')
ax.set_yticks(ys)
ax.set_yticklabels([ylab[t] for t in order])
ax.set_xlabel('Mean Pearson r over general-130 benchmark  (mean ± 95% CI over 5 training seeds; arrow = CI off-scale)')
ax.set_title('DeepPBS accuracy by TF family, three conditions side by side', loc='left')
ax.set_xlim(*XL1)
ax.margins(y=0.03)
set_frame(ax)
ax.annotate('higher r = better →', xy=(1.0, -0.12), xycoords='axes fraction', ha='right', va='top', fontsize=6, color='0.5')
handles = [Line2D([0], [0], marker='o', color=c, markersize=6, label=l, lw=0, mec='white') for _, _, l, c in arms]
ax.legend(handles=handles, loc='upper center', bbox_to_anchor=(0.5, -0.15), ncol=3, frameon=False, fontsize=6.5,
          handletextpad=0.3, columnspacing=1.5)
fig.tight_layout()
fig.savefig('fig1_three_arm_accuracy.png', dpi=300, bbox_inches='tight')
